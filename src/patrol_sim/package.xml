<?xml version="1.0"?>
<package format="3">
  <name>patrol_sim</name><version>1.0.0</version>
  <description>Lightweight differential robot simulator, guard and control panel.</description>
  <maintainer email="maintainer@example.com">Patrol project</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>patrol_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>

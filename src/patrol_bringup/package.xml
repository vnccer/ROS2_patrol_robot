<?xml version="1.0"?>
<package format="3">
  <name>patrol_bringup</name><version>1.0.0</version>
  <description>Indoor patrol simulation, Nav2 and mission system launch.</description>
  <maintainer email="maintainer@example.com">Patrol project</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>patrol_manager</exec_depend><exec_depend>patrol_sim</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav2_bringup</exec_depend><exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>navigation2</exec_depend><exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>rviz2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
